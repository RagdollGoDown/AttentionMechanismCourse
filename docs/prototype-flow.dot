// Lesson flow of the Attention Seekers prototype (web/content/steps.ts).
// Render: dot -Tpdf docs/prototype-flow.dot -o docs/prototype-flow.pdf  (and -Tpng / -Tsvg)
digraph flow {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=0.45, compound=true, newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef2fb", color="#3b5bdb", penwidth=1.2, margin="0.15,0.08"];
  edge  [color="#555555", arrowsize=0.7];

  subgraph cluster_start {
    label=<<b>1 · Start</b>>; style="rounded,dashed"; color="#999999";
    welcome [label=<<b>Welcome</b><br/><font point-size="9">"How does a word know<br/>what it means?"</font>>];
    hook    [label=<<b>Hook</b><br/><font point-size="9">"model" alone → sentence A<br/>→ sentence B: what does it mean?</font>>];
    why     [label=<<b>Why attention?</b><br/><font point-size="9">used in GPT, Claude…<br/>learning goals, trophy</font>>];
    pretest [label=<<b>Pre-test</b><br/><font point-size="9">(placeholder)</font>>, fillcolor="#e9ecef", color="#868e96"];
    { rank=same; welcome; hook; why; pretest; }
  }

  subgraph cluster_warm {
    label=<<b>2 · Warm-up</b> <font point-size="10">(skippable)</font>>; style="rounded,dashed"; color="#999999";
    vec1 [label=<<b>A word is a vector</b><br/><font point-size="9">2-D meaning map, hover = vector<br/>dimension, learned embeddings</font>>];
    vec2 [label=<<b>The dot product</b><br/><font point-size="9">drag b: a·b = 0, most negative,<br/>[2,1]·[1,3] by hand</font>>];
    { rank=same; vec1; vec2; }
  }

  subgraph cluster_lab {
    label=<<b>3 · Sentence lab</b> <font point-size="10">one sentence on the board · experiments unlock one by one</font>>; style="rounded,dashed"; color="#999999";
    contrast [label=<<b>① Two contexts</b><br/><font point-size="9">guess the word "model"<br/>listens to, reveal bars</font>>];
    qk       [label=<<b>② Query &amp; key</b><br/><font point-size="9">"Who matches me?"<br/>match-score leaderboard</font>>];
    swap     [label=<<b>③ Swap a word</b><br/><font point-size="9">predict → reveal → explain<br/>meaning, not position</font>>, fillcolor="#fff4e6", color="#e8590c", penwidth=2];
    remove   [label=<<b>④ Remove a word</b><br/><font point-size="9">predict → reveal → explain<br/>weights sum to 100 %</font>>, fillcolor="#fff4e6", color="#e8590c", penwidth=2];
    rule     [label=<<b>⑤ Invent the rule</b><br/><font point-size="9">productive failure:<br/>build scores → weights</font>>];
    softmax  [label=<<b>⑥ Meet softmax</b><br/><font point-size="9">s → eˢ → eˢ ÷ sum<br/>check: 2, 1, 0 → 67 %</font>>];
    { rank=same; contrast; qk; swap; remove; rule; softmax; }
  }

  subgraph cluster_formula {
    label=<<b>4 · Formula</b>>; style="rounded,dashed"; color="#999999";
    formula [label=<<b>The formula</b>  softmax(QKᵀ/√dₖ)·V<br/><font point-size="9">click Q, Kᵀ, √dₖ (slider), softmax, V<br/>"model" moves toward fashion</font>>];
    explain [label=<<b>Explain it yourself</b><br/><font point-size="9">one sentence per part<br/>(Q, Kᵀ, √dₖ, softmax, V)</font>>, fillcolor="#fff4e6", color="#e8590c", penwidth=2];
    { rank=same; formula; explain; }
  }

  subgraph cluster_finish {
    label=<<b>5 · Finish</b>>; style="rounded,dashed"; color="#999999";
    posttest [label=<<b>Post-test</b><br/><font point-size="9">(placeholder)</font>>, fillcolor="#e9ecef", color="#868e96"];
    endscr   [label=<<b>End</b><br/><font point-size="9">full trophy, goals reached,<br/>download session log</font>>];
    { rank=same; posttest; endscr; }
  }

  // The only part that differs between conditions.
  subgraph cluster_loop {
    label=<<b>Explain loop</b> <font point-size="10">at every orange step · the only part that differs</font>>; style="rounded,filled"; fillcolor="#fff9f2"; color="#e8590c";
    write  [label=<<b>Write explanation</b>>, fillcolor="white", color="#e8590c"];
    ai     [label=<<b>AI condition</b><br/><font point-size="9">adaptive tutor: what is right,<br/>the one missing idea, a probe<br/>back to the board · never the formula</font>>, fillcolor="#e6fcf5", color="#0ca678"];
    ctrl   [label=<<b>Control condition</b><br/><font point-size="9">fixed expert answer</font>>, fillcolor="#f3f0ff", color="#7048e8"];
    revise [label=<<b>Optional revision</b><br/><font point-size="9">max 2 rounds</font>>, fillcolor="white", color="#e8590c"];
    write -> ai; write -> ctrl; ai -> revise; ctrl -> revise;
  }

  // Rows stay left-aligned: an invisible spine links the first node of each row.
  welcome -> vec1 -> contrast -> formula -> posttest [style=invis, weight=20];
  // The loop sits beside the formula and finish rows.
  { rank=same; explain; write; }
  explain -> write [style=invis];

  welcome -> hook -> why -> pretest;
  vec1 -> vec2;
  contrast -> qk -> swap -> remove -> rule -> softmax;
  formula -> explain;
  posttest -> endscr;
  // Chapter-to-chapter steps.
  edge [constraint=false, color="#3b5bdb", penwidth=1.3];
  pretest -> vec1 [lhead=cluster_warm];
  vec2 -> contrast [lhead=cluster_lab];
  softmax -> formula [ltail=cluster_lab, lhead=cluster_formula];
  explain -> posttest [ltail=cluster_formula, lhead=cluster_finish];

  legend [shape=plaintext, style="", label=<<font point-size="9">Every finished module wins a trophy piece (completion only, same in both conditions).<br/>Logged throughout: actions, predictions, explanations, feedback, revisions, time per step.</font>>];
  posttest -> legend [style=invis, constraint=true];
}
